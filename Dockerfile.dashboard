# Dashboard image is deliberately separate from the CLI runtime.
# The application only reads allowlisted saved results and has no provider credentials.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.22 /uv /uvx /usr/local/bin/

WORKDIR /app

# Use the repository's committed lockfile for all core dependencies.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
RUN uv sync --frozen --no-dev

# The UI is isolated from the experiment dependencies. Install it during
# the image build (never at container start), with a fixed direct version.
RUN uv pip install --python /app/.venv/bin/python "streamlit==1.51.0"

COPY dashboard ./dashboard

# Non-root, least-privilege execution; runtime results are mounted read-only.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin dashboard \
    && mkdir -p /app/results \
    && chown -R dashboard:dashboard /app/results

USER dashboard
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
